# Environment Configuration Template
# Copy this file to .env and modify as needed for your environment.

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Git Integration Security Settings

# Default path for git repositories
# This will be used when no git path is explicitly set
DEFAULT_GIT_REPOSITORY_PATH=/path/to/your/default/git/repository

# Allowed base directories for git repositories (comma-separated)
# Users can only set git paths within these directories for security
# Example: /path/to/projects,/another/allowed/path
ALLOWED_GIT_REPOSITORY_BASES=

# Maximum number of git operations per hour (rate limiting)
GIT_OPERATIONS_RATE_LIMIT=100

# Enable logging for git operations (True/False)
GIT_OPERATION_LOGGING=True

# Database Settings (if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Additional Django Settings
# TIME_ZONE=America/New_York
# LANGUAGE_CODE=en-us
